# NG-81220
^wireless /etc/init.d/hostapd reload && ubus send config "{'reload':'wireless'}" ;
^wireless%.[^%.]+%.wl[^%.]+%.state /etc/init.d/network reload ;
^wireless%.[^%.]+%.radio_[^%.]+%.state [ -f /usr/lib/hotspot/control.sh ] && /usr/lib/hotspot/control.sh evaluate
^wireless%..+%.upload_rate [ -x /etc/hotplug.d/net/60-guestwifi-rate-limiting ] && /etc/hotplug.d/net/60-guestwifi-rate-limiting RELOAD || true
^wireless%..+%.download_rate [ -x /etc/hotplug.d/net/60-guestwifi-rate-limiting ] && /etc/hotplug.d/net/60-guestwifi-rate-limiting RELOAD || true
^wireless%..+%.rate_control_enabled [ -x /etc/hotplug.d/net/60-guestwifi-rate-limiting ] && /etc/hotplug.d/net/60-guestwifi-rate-limiting RELOAD || true
^wireless%.[^%.]+%.wl[^%.]+%.state /etc/init.d/network reload
^ACSRescan%. /usr/bin/ubus call wireless.radio.acs rescan
